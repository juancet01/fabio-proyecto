<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <H1>MOSTRAR TODO</H1>


  <table>
    <thead>
        <th>ID</th>
        <th>NOMBRE</th>
        <th>DIRECCION</th>
        <th>TELEFONO</th>
    </thead>
    <tbody>
  


     <% if(registros.length > 0){
        registros.forEach(cli=>{%>
            
            <tr>

            <td><%= cli.idclientes %></td>

            <td><%=cli.nombre %></td> 

            <td><%=cli.direccion %></td>

            <td><%=cli.telefono %></td>     
             
            </tr>
            
       <% })
     }else{%>
        <p>no hay clientes</p>
    <% } %> 
    </tbody>
    </table>
    
   
</body>
</html>